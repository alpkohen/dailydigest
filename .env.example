# Copy relevant vars into apps/web/.env.local (web) and worker/.env (worker).
# Never commit real values — .gitignore already excludes .env*.

# --- apps/web (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Single-owner allowlist enforced in middleware.ts (SPEC.md section 2).
OWNER_EMAIL=

# --- worker (server-only secrets, never exposed to the browser bundle) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# All roles run on OpenAI (config/models.yaml), so this is required.
OPENAI_API_KEY=
# Optional: only needed if a role is switched to Anthropic later.
ANTHROPIC_API_KEY=
# UUID of the owner's auth.users row. Sign in once via /login, then copy the
# id shown on the home page.
OWNER_ID=

# --- packages/db migrations (direct Postgres connection, not the API URL) ---
DATABASE_URL=
